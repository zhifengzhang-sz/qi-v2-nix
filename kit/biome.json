{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": { "includes": ["**/*.ts", "**/*.json", "!**/node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "!src/edge/**"],
      "plugins": [
        "biome/no-class.grit",
        "biome/no-throw.grit",
        "biome/no-try.grit",
        "biome/no-let.grit",
        "biome/no-loop.grit",
        "biome/no-random.grit"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "bun",
                      "bun:*",
                      "fs",
                      "fs/*",
                      "path",
                      "child_process",
                      "os",
                      "process"
                    ],
                    "message": "an effect: only in src/edge/ (dev/ts/STYLE.md)"
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "an effect: only in src/edge/ (dev/ts/STYLE.md)",
                  "process": "an effect: only in src/edge/ (dev/ts/STYLE.md)",
                  "Bun": "an effect: only in src/edge/ (dev/ts/STYLE.md)",
                  "console": "an effect: only in src/edge/ (dev/ts/STYLE.md)",
                  "Date": "the clock is an effect: pass the time in (dev/ts/STYLE.md)"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/edge/**"],
      "plugins": ["biome/no-class.grit", "biome/no-throw.grit", "biome/no-let.grit", "biome/no-loop.grit"]
    }
  ]
}
